# ---- Build stage ----
FROM golang:1.25-alpine AS builder

# Build context is the repo root, so the proto module is available at ../proto
WORKDIR /src

COPY proto ./proto
COPY payments-service/go.mod payments-service/go.sum ./payments-service/

WORKDIR /src/payments-service
RUN go mod download

COPY payments-service/ .
RUN CGO_ENABLED=0 GOOS=linux go build -o payments-service ./cmd/main.go

# ---- Final stage ----
FROM alpine:latest

WORKDIR /app

COPY --from=builder /src/payments-service/payments-service .
COPY --from=builder /src/payments-service/migrations ./migrations

EXPOSE 8080 9090

CMD ["./payments-service"]
