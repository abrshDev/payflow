{
    "info": {
        "_postman_id": "f4e3f6c7-9d8b-4b50-9de4-7e2a1d88f3a1",
        "name": "Payflow Payments Service",
        "description": "Requests for creating and moving a payment through its lifecycle.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8081"
        },
        {
            "key": "merchantId",
            "value": "11111111-1111-1111-1111-111111111111"
        },
        {
            "key": "paymentId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Create payment",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"merchant_id\": \"{{merchantId}}\",\n  \"amount\": 2500,\n  \"currency\": \"USD\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/payments",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "payments"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('created', function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "var payment = pm.response.json();",
                            "pm.collectionVariables.set('paymentId', payment.id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get payment",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/payments/{{paymentId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "payments",
                        "{{paymentId}}"
                    ]
                }
            }
        },
        {
            "name": "Authorize payment",
            "request": {
                "method": "POST",
                "url": {
                    "raw": "{{baseUrl}}/payments/{{paymentId}}/authorize",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "payments",
                        "{{paymentId}}",
                        "authorize"
                    ]
                }
            }
        },
        {
            "name": "Capture payment",
            "request": {
                "method": "POST",
                "url": {
                    "raw": "{{baseUrl}}/payments/{{paymentId}}/capture",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "payments",
                        "{{paymentId}}",
                        "capture"
                    ]
                }
            }
        },
        {
            "name": "Refund payment",
            "request": {
                "method": "POST",
                "url": {
                    "raw": "{{baseUrl}}/payments/{{paymentId}}/refund",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "payments",
                        "{{paymentId}}",
                        "refund"
                    ]
                }
            }
        }
    ]
}